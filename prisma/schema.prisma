// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

enum UserStatus {
  PENDING
  APPROVED
  REJECTED
}

enum QuestionType {
  SINGLE
  MULTIPLE
  MATCHING
  TRUE_FALSE
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  role         Role
  status       UserStatus
  createdAt    DateTime   @default(now())

  categories Category[]
  questions  Question[]
  media      Media[]
}

model RateLimitCounter {
  key         String   @id
  count       Int
  windowStart DateTime
  updatedAt   DateTime @updatedAt
}

model Category {
  id        String   @id @default(cuid())
  teacherId String
  name      String
  createdAt DateTime @default(now())

  teacher   User       @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  questions Question[]

  @@index([teacherId])
}

model Question {
  id         String       @id @default(cuid())
  teacherId  String
  categoryId String?
  type       QuestionType
  body       String       @db.Text
  bodyText   String       @db.Text
  explanation String?     @db.Text
  points     Decimal      @db.Decimal(10, 2)
  deletedAt  DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  teacher  User             @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  category Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  options  QuestionOption[]

  @@index([teacherId])
  @@index([categoryId])
  @@index([deletedAt])
}

model QuestionOption {
  id         String   @id @default(cuid())
  questionId String
  text       String   @db.Text
  isCorrect  Boolean  @default(false)
  side       String?
  matchKey   String?
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

model Media {
  id         String   @id @default(cuid())
  teacherId  String
  storageKey String
  mime       String
  sizeBytes  Int
  width      Int?
  height     Int?
  createdAt  DateTime @default(now())

  teacher User @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId])
}
